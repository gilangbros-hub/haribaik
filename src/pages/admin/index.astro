---
import '../../styles/admin.css';
import { getGuests, guestAdminDb } from '../../lib/guests/server';

const user = Astro.locals.adminUser;
if (!user) return Astro.redirect('/admin/login');
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
const guests = await getGuests(guestAdminDb());
const activeGuests = guests.filter(({ active }) => active);
const inactiveGuests = guests.filter(({ active }) => !active);
const attending = activeGuests.filter(({ guest_rsvps }) => guest_rsvps?.status === 'attending').length;
const declined = activeGuests.filter(({ guest_rsvps }) => guest_rsvps?.status === 'declined').length;
const unanswered = activeGuests.filter(({ guest_rsvps }) => !guest_rsvps).length;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>Admin — HariBahagia</title>
  </head>
  <body>
    <main class="admin-shell">
      <div class="admin-topbar">
        <div>
          <p class="admin-eyebrow">Login sebagai {user.email}</p>
          <h1>Pengelolaan undangan</h1>
        </div>
        <form method="post" action="/api/admin/logout"><button class="md-btn md-btn--outlined" type="submit">Keluar</button></form>
      </div>

      <ul class="md-stats">
        <li class="md-stat"><b>{activeGuests.length}</b><span>Tamu aktif</span></li>
        <li class="md-stat"><b>{attending}</b><span>Hadir</span></li>
        <li class="md-stat"><b>{declined}</b><span>Tidak hadir</span></li>
        <li class="md-stat"><b>{unanswered}</b><span>Belum menjawab</span></li>
      </ul>

      <section class="md-card" aria-labelledby="rsvp-summary-title">
        <h2 id="rsvp-summary-title">Tamu nonaktif ({inactiveGuests.length})</h2>
        {inactiveGuests.length
          ? <div class="md-table-wrap"><table class="md-table"><thead><tr><th>Nama</th><th>RSVP</th></tr></thead><tbody>{inactiveGuests.map((guest) => <tr><td>{guest.name}</td><td>{guest.guest_rsvps?.status === 'attending' ? 'Hadir' : guest.guest_rsvps?.status === 'declined' ? 'Tidak hadir' : 'Belum menjawab'}</td></tr>)}</tbody></table></div>
          : <p class="md-card-hint">Tidak ada tamu nonaktif.</p>}
      </section>

      <section class="md-card">
        <h2>Kelola</h2>
        <div class="md-actions">
          <a class="md-btn md-btn--tonal" href="/admin/content">Kelola konten undangan</a>
          <a class="md-btn md-btn--tonal" href="/admin/guests">Kelola daftar tamu</a>
        </div>
      </section>
    </main>
  </body>
</html>
