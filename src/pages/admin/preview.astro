---
import InvitationPage from '../../components/InvitationPage.astro';
import { readWeddingDraft } from '../../lib/content/store';
import { resolveWeddingMedia } from '../../lib/content/media';

const user = Astro.locals.adminUser;
if (!user) return Astro.redirect('/admin/login');
let invitation = null;
let media = null;
let unavailable = !Astro.locals.supabase;
if (Astro.locals.supabase) {
  try {
    invitation = await readWeddingDraft(Astro.locals.supabase);
    media = await resolveWeddingMedia(Astro.locals.supabase, invitation);
  } catch {
    unavailable = true;
    Astro.response.status = 503;
  }
}
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#183e33" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Preview draf — Admin HariBahagia</title>
  </head>
  <body>
    {invitation
      ? <InvitationPage invitation={invitation} recipient="Nama tamu contoh" preview calendarUrl="/api/admin/content/calendar.ics" media={media ?? undefined} />
      : <main class="fallback">
          <div class="card">
            <p class="eyebrow">Preview</p>
            <h1>{unavailable ? 'Preview tidak tersedia' : 'Draf belum tersedia'}</h1>
            <p>Periksa koneksi database dan simpan draf terlebih dahulu.</p>
            <a class="btn" href="/admin/content">Kembali ke konten</a>
          </div>
        </main>}

    {!invitation && (
      <style is:global>
        :root { color-scheme: light; }
        body { margin: 0; font-family: 'DM Sans', -apple-system, system-ui, sans-serif; background: #f6f6f8; color: #0b0b0f; }
        .fallback { display: grid; place-items: center; min-height: 100svh; padding: 24px; }
        .fallback .card { width: min(100%, 400px); background: #fff; border-radius: 24px; padding: 28px; box-shadow: 0 10px 30px rgba(17,17,17,.08); text-align: center; }
        .fallback .eyebrow { display: inline-block; margin: 0 0 8px; padding: 4px 12px; border-radius: 999px; background: #b7c9a8; font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
        .fallback h1 { margin: 0 0 12px; font-size: 1.5rem; font-weight: 700; letter-spacing: -.02em; }
        .fallback p { color: #6e6e73; line-height: 1.6; }
        .fallback .btn { display: inline-flex; align-items: center; min-height: 46px; padding: 0 24px; margin-top: 16px; font-weight: 700; border-radius: 999px; text-decoration: none; background: #b7c9a8; color: #0b0b0f; }
      </style>
    )}
  </body>
</html>
