---
import '../../styles/admin.css';
import { getGuests, guestAdminDb } from '../../lib/guests/server';

const user = Astro.locals.adminUser;
if (!user) return Astro.redirect('/admin/login');
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
const guests = await getGuests(guestAdminDb());
const activeGuests = guests.filter(({ active }) => active);
const inactiveGuests = guests.filter(({ active }) => !active);
const sent = activeGuests.filter((guest) => guest.sent).length;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>Admin — HariBahagia</title>
  </head>
  <body>
    <main class="admin-shell">
      <div class="admin-topbar">
        <div>
          <p class="admin-eyebrow">Login sebagai {user.email}</p>
          <h1>Pengelolaan undangan</h1>
        </div>
        <form method="post" action="/api/admin/logout"><button class="md-btn md-btn--outlined" type="submit">Keluar</button></form>
      </div>

      <ul class="md-stats">
        <li class="md-stat"><b>{activeGuests.length}</b><span>Tamu aktif</span></li>
        <li class="md-stat"><b>{sent}</b><span>Sudah dikirim</span></li>
        <li class="md-stat"><b>{activeGuests.length - sent}</b><span>Belum dikirim</span></li>
      </ul>

      <section class="md-card" aria-labelledby="inactive-summary-title">
        <h2 id="inactive-summary-title">Tamu nonaktif ({inactiveGuests.length})</h2>
        {inactiveGuests.length
          ? <ul>{inactiveGuests.map((guest) => <li>{guest.name}</li>)}</ul>
          : <p class="md-card-hint">Tidak ada tamu nonaktif.</p>}
      </section>

      <section class="md-card">
        <h2>Kelola</h2>
        <ul class="admin-nav">
          <li><a href="/admin/content"><b>Konten undangan</b><span>Draf, foto, musik, publish</span></a></li>
          <li><a href="/admin/guests"><b>Daftar tamu</b><span>CSV, status pengiriman, tautan tamu</span></a></li>
          <li><a href="/admin/users"><b>Akun admin</b><span>Tambah akun untuk login</span></a></li>
        </ul>
      </section>
    </main>
  </body>
</html>
