---
import InvitationPage from '../../components/InvitationPage.astro';
import { readWeddingDraft } from '../../lib/content/store';
import { resolveWeddingMedia } from '../../lib/content/media';

const user = Astro.locals.adminUser;
if (!user) return Astro.redirect('/admin/login');
let invitation = null;
let media = null;
let unavailable = !Astro.locals.supabase;
if (Astro.locals.supabase) {
  try {
    invitation = await readWeddingDraft(Astro.locals.supabase);
    media = await resolveWeddingMedia(Astro.locals.supabase, invitation);
  } catch {
    unavailable = true;
    Astro.response.status = 503;
  }
}
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#183e33" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Preview draf — Admin HariBahagia</title>
  </head>
  <body>
    {invitation
      ? <InvitationPage invitation={invitation} recipient="Nama tamu contoh" preview calendarUrl="/api/admin/content/calendar.ics" media={media ?? undefined} />
      : <main class="fallback">
          <div class="card">
            <p class="eyebrow">Preview</p>
            <h1>{unavailable ? 'Preview tidak tersedia' : 'Draf belum tersedia'}</h1>
            <p>Periksa koneksi database dan simpan draf terlebih dahulu.</p>
            <a class="btn" href="/admin/content">Kembali ke konten</a>
          </div>
        </main>}

    {!invitation && (
      <style is:global>
        :root { color-scheme: light; }
        body { margin: 0; font-family: 'DM Sans', system-ui, sans-serif; background: #fbf9f2; color: #1b1c18; }
        .fallback { display: grid; place-items: center; min-height: 100svh; padding: 24px; }
        .fallback .card { width: min(100%, 400px); background: #f3efe3; border: 1px solid #c6c8ba; border-radius: 16px; padding: 28px; box-shadow: 0 1px 3px 1px #00000014; text-align: center; }
        .fallback .eyebrow { margin: 0 0 4px; font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #9a7945; }
        .fallback h1 { margin: 0 0 12px; font-size: 1.5rem; font-weight: 600; }
        .fallback p { color: #45483f; line-height: 1.6; }
        .fallback .btn { display: inline-flex; align-items: center; min-height: 42px; padding: 0 22px; margin-top: 16px; font-weight: 500; border-radius: 20px; text-decoration: none; background: #cfe9dc; color: #0a2219; }
      </style>
    )}
  </body>
</html>
