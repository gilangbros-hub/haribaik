---
import type { WeddingContent } from '../lib/content';
import { formatWeddingDate } from '../lib/content';
import type { WeddingMediaUrls } from '../lib/content/media';
import '../styles/invitation.css';

interface Props {
  invitation: WeddingContent;
  recipient?: string;
  preview?: boolean;
  calendarUrl?: string;
  media?: WeddingMediaUrls;
  guestSlug?: string;
  rsvpStatus?: 'attending' | 'declined' | null;
}

const { invitation, recipient = 'Sahabat dan keluarga', preview = false, calendarUrl = '/calendar.ics', media, guestSlug, rsvpStatus = null } = Astro.props;
const coupleName = `${invitation.brideName} & ${invitation.groomName}`;
const firstDate = invitation.events[0] ? formatWeddingDate(invitation.events[0].startsAt, invitation.timeZone) : '';
const profiles = [
  { name: invitation.brideName, role: 'Mempelai wanita' },
  { name: invitation.groomName, role: 'Mempelai pria' },
];
---

<aside class="desktop-story" aria-label="Pernikahan">
  <a class="wordmark" href="#cover-title"><span aria-hidden="true">✳</span> HARI BAHAGIA</a>
  <div class="story-copy">
    <p class="eyebrow">Dari dua hati, menjadi satu cerita</p>
    <p class="story-title">Mugia langgeng<br /><em>salawasna.</em></p>
    <p class="story-translation">Semoga bersama, selamanya.</p>
    <div class="story-rule"></div>
    <p class="story-couple">{coupleName}</p>
    <p class="story-date">{firstDate}</p>
  </div>
  <img class="story-landscape" src="/images/priangan-landscape.webp" alt="" width="1536" height="1024" />
  <p class="story-footnote">SEBUAH JANJI YANG TUMBUH BERSAMA <span aria-hidden="true">✧</span></p>
</aside>

<main id="invitation" tabindex="-1">
  <section class="cover" aria-labelledby="cover-title">
    {media?.coverImage
      ? <img class="cover-visual cover-photo" src={media.coverImage} alt={invitation.coverImage?.alt ?? ''} width="853" height="1280" fetchpriority="high" />
      : <img class="cover-visual" src="/images/priangan-landscape.webp" alt="" width="1536" height="1024" fetchpriority="high" />}
    <div class="cover-art" aria-hidden="true">
      <img class="cover-botanical botanical-left" src="/images/jasmine-branch.svg" alt="" width="180" height="360" />
      <img class="cover-botanical botanical-right" src="/images/jasmine-branch.svg" alt="" width="180" height="360" />
      <span class="cover-frame"></span>
    </div>
    <div class="cover-topline"><span aria-hidden="true">✧</span><span>WILUJENG SUMPING</span><span aria-hidden="true">✧</span></div>
    <p class="eyebrow">{invitation.title}</p>
    <h1 id="cover-title"><span>{invitation.brideName}</span><i>&</i><span>{invitation.groomName}</span></h1>
    {firstDate && <p class="cover-date">{firstDate}</p>}
    <div class="recipient-card">
      <span>Kepada Bapak/Ibu/Saudara/i</span>
      <strong>{recipient}</strong>
    </div>
    <button class="open-button" type="button" data-open-invitation aria-controls="invitation-body">
      Buka Undangan <span aria-hidden="true">↗</span>
    </button>
    {media?.music && <><button class="music-button" type="button" data-music-toggle aria-pressed="false">Putar musik</button><audio data-invitation-audio src={media.music} preload="none" aria-label="Musik undangan"></audio><p data-audio-status role="status" aria-live="polite"></p></>}
    {preview && <p class="sample-note">Preview draf — hanya terlihat oleh admin</p>}
  </section>

  <div id="invitation-body" class="invitation-body" tabindex="-1">
    <section class="welcome section" aria-labelledby="welcome-title">
      <span class="section-number" aria-hidden="true">01 / PAMBUKA</span>
      <img class="welcome-flower" src="/images/jasmine-branch.svg" alt="" width="100" height="200" loading="lazy" />
      <p class="eyebrow">{invitation.greeting}</p>
      <h2 id="welcome-title">Bersama, merajut<br /><em>cerita selamanya.</em></h2>
      {invitation.description && <p>{invitation.description}</p>}
      <span class="ornament" aria-hidden="true">✳</span>
    </section>

    <section id="mempelai" class="profiles section" aria-labelledby="profiles-title">
      <span class="section-number" aria-hidden="true">02 / DUA HATI</span>
      <p class="eyebrow">Silih asih, silih asah, silih asuh</p>
      <h2 id="profiles-title">Kami yang <em>berbahagia</em></h2>
      <div class="profile-grid">
          {profiles.map((profile, index) => {
            const image = index === 0 ? media?.brideImage : media?.groomImage;
            const imageData = index === 0 ? invitation.brideImage : invitation.groomImage;
            return (
          <article class="profile-card">
            <div class:list={['portrait', index === 0 ? 'portrait-one' : 'portrait-two']}>
              {image ? <img src={image} alt={imageData?.alt ?? ''} width="230" height="265" loading="lazy" /> : <span role="img" aria-label={`Foto ${profile.role} belum tersedia`}>{profile.name.charAt(0)}</span>}
            </div>
            <p class="eyebrow">{profile.role}</p>
            <h3>{profile.name}</h3>
          </article>
          );})}
      </div>
    </section>

    <div id="acara" class="events-wrap">
    {invitation.events.map((event, index) => (
      <section class="event section" aria-labelledby={`event-title-${index}`}>
        <span class="section-number" aria-hidden="true">{String(index + 3).padStart(2, '0')} / WAKTU & TEMPAT</span>
        <p class="eyebrow">Hadir dan menjadi bagian cerita kami</p>
        <h2 id={`event-title-${index}`}>{event.name || 'Acara'}</h2>
        <article class="event-card">
          <p class="event-name">{event.name}</p>
          <p class="event-date">{event.startsAt && formatWeddingDate(event.startsAt, invitation.timeZone)}</p>
          <p class="event-time">
            {event.startsAt && formatWeddingDate(event.startsAt, invitation.timeZone, { hour: '2-digit', minute: '2-digit' })}
            {event.endsAt && `–${formatWeddingDate(event.endsAt, invitation.timeZone, { hour: '2-digit', minute: '2-digit' })}`}
            {` ${invitation.timeZone}`}
          </p>
          {event.startsAt && event.endsAt && event.startsAt.slice(0, 10) !== event.endsAt.slice(0, 10) && <p class="event-time">Sampai {formatWeddingDate(event.endsAt, invitation.timeZone)}</p>}
          <div class="rule"></div>
          <h3>{event.venue}</h3>
          <p>{event.address}</p>
          <div class="event-actions">
            {event.mapUrl && <a class="text-link" href={event.mapUrl} target="_blank" rel="noreferrer">Petunjuk arah <span aria-hidden="true">↗</span></a>}
            <a class="text-link" href={calendarUrl} download="undangan.ics">Simpan tanggal <span aria-hidden="true">↓</span></a>
          </div>
        </article>
      </section>
    ))}
    </div>

    {media?.gallery.some(Boolean) && (
      <section id="galeri" class="gallery section" aria-labelledby="gallery-title">
        <p class="eyebrow">Kepingan cerita kita</p>
        <h2 id="gallery-title">Yang ingin kami <em>kenang.</em></h2>
        <div class="gallery-grid">
          {media.gallery.map((url, index) => url && invitation.gallery[index] && <img src={url} alt={invitation.gallery[index].alt} width="600" height="600" loading="lazy" decoding="async" />)}
        </div>
      </section>
    )}

    <section id="kehadiran" class="rsvp section" aria-labelledby="rsvp-title">
      <span class="ornament" aria-hidden="true">✳</span>
      <p class="eyebrow">Sebuah kebahagiaan untuk kami</p>
      <h2 id="rsvp-title">Sampai jumpa<br /><em>di hari bahagia.</em></h2>
      {guestSlug ? <>
        <p>Undangan ini berlaku untuk satu orang.</p>
        <form data-rsvp-form data-endpoint={`/api/guests/${encodeURIComponent(guestSlug)}/rsvp`}>
          <fieldset>
            <legend>Apakah Anda akan hadir?</legend>
            <label><input type="radio" name="status" value="attending" checked={rsvpStatus === 'attending'} required /> Hadir</label>
            <label><input type="radio" name="status" value="declined" checked={rsvpStatus === 'declined'} required /> Tidak hadir</label>
          </fieldset>
          <button type="submit">Simpan jawaban</button>
          <p data-rsvp-status role="status" aria-live="polite">{rsvpStatus === 'attending' ? 'Jawaban tersimpan: hadir.' : rsvpStatus === 'declined' ? 'Jawaban tersimpan: tidak hadir.' : ''}</p>
        </form>
      </> : <p>Konfirmasi kehadiran tersedia melalui tautan undangan personal.</p>}
    </section>

    <footer class="closing section">
      <span class="monogram" aria-hidden="true">{invitation.brideName.charAt(0)} <i>&</i> {invitation.groomName.charAt(0)}</span>
      <p>{invitation.closing}</p>
      <p class="eyebrow">Kalayan kanyaah · Dengan cinta</p>
      <h2>{coupleName}</h2>
      {firstDate && <p class="footer-date">{firstDate}</p>}
      <p class="made-with">HARI BAHAGIA <span aria-hidden="true">✧</span> MUGIA LANGGENG SALAWASNA</p>
    </footer>
  </div>
  <nav class="invitation-nav" aria-label="Bagian undangan">
    <a href="#cover-title" aria-label="Sampul"><span aria-hidden="true">⌂</span></a>
    <a href="#mempelai">Mempelai</a>
    <a href="#acara">Acara</a>
    {media?.gallery.some(Boolean) && <a href="#galeri">Galeri</a>}
    <a href="#kehadiran">RSVP</a>
  </nav>
</main>

<script>
  const audio = document.querySelector<HTMLAudioElement>('[data-invitation-audio]');
  const musicButton = document.querySelector<HTMLButtonElement>('[data-music-toggle]');
  const audioStatus = document.querySelector<HTMLElement>('[data-audio-status]');
  const updateMusic = () => {
    if (!audio || !musicButton) return;
    const playing = !audio.paused;
    musicButton.textContent = playing ? 'Jeda musik' : 'Putar musik';
    musicButton.setAttribute('aria-pressed', String(playing));
  };
  audio?.addEventListener('play', updateMusic);
  audio?.addEventListener('pause', updateMusic);
  audio?.addEventListener('error', () => { if (audioStatus) audioStatus.textContent = 'Musik tidak dapat diputar. Anda tetap dapat membaca undangan.'; });
  const startMusic = () => {
    if (!audio) return;
    audio.play().then(() => { if (audioStatus) audioStatus.textContent = ''; }).catch(() => {
      if (audioStatus) audioStatus.textContent = 'Musik tidak dapat diputar. Anda tetap dapat membaca undangan.';
    });
  };
  musicButton?.addEventListener('click', () => {
    if (!audio) return;
    if (audio.paused) startMusic();
    else audio.pause();
  });
  document.querySelector('[data-open-invitation]')?.addEventListener('click', () => {
    const body = document.querySelector<HTMLElement>('#invitation-body');
    if (!body) return;
    document.querySelector('#invitation')?.classList.add('is-open');
    startMusic();
    body.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    body.focus({ preventScroll: true });
  });

  const sections = document.querySelectorAll<HTMLElement>('.invitation-body .section');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });
    sections.forEach((section) => { section.classList.add('will-reveal'); observer.observe(section); });
  }
</script>

<script>
  document.querySelector<HTMLFormElement>('[data-rsvp-form]')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[data-rsvp-status]')!;
    const answer = new FormData(form).get('status');
    if (answer !== 'attending' && answer !== 'declined') {
      status.textContent = 'Pilih hadir atau tidak hadir.';
      return;
    }
    button.disabled = true;
    status.textContent = 'Mengirim jawaban…';
    try {
      const response = await fetch(form.dataset.endpoint!, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ status: answer }),
      });
      const result = await response.json();
      if (!response.ok || result.saved !== true) throw new Error(result.error || 'Jawaban belum tersimpan.');
      status.textContent = answer === 'attending' ? 'Jawaban tersimpan: hadir.' : 'Jawaban tersimpan: tidak hadir.';
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Jawaban belum tersimpan. Periksa koneksi lalu coba lagi.';
    } finally {
      button.disabled = false;
    }
  });
</script>
