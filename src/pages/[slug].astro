---
import InvitationPage from '../components/InvitationPage.astro';
import { publicContentClient, readPublishedWedding } from '../lib/content/store';
import { guestAdminDb } from '../lib/guests/server';
import { readActiveGuest } from '../lib/guests/public';
import type { WeddingContent } from '../lib/content';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const baseUrl = import.meta.env.PUBLIC_SITE_URL;
let canonicalUrl: string | null = null;
let invitation: WeddingContent | null = null;
let recipient: string | null = null;
let rsvpStatus: 'attending' | 'declined' | null = null;
let unavailable = false;

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const validSlug = slug.length <= 64 && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug);
if (validSlug) {
  try {
    const guest = await readActiveGuest(guestAdminDb(), slug);
    if (guest) {
      const client = publicContentClient();
      if (!client) throw new Error('Public content storage is unavailable.');
      invitation = await readPublishedWedding(client);
      if (invitation) {
        const base = baseUrl ? new URL(baseUrl) : null;
        if (!base || base.protocol !== 'https:' || base.username || base.password || base.search || base.hash || base.pathname !== '/') {
          throw new Error('PUBLIC_SITE_URL must be a canonical HTTPS origin.');
        }
        recipient = guest.name;
        rsvpStatus = guest.rsvpStatus;
        canonicalUrl = new URL(encodeURIComponent(slug), base).toString();
      }
    }
  } catch {
    unavailable = true;
  }
}

const found = invitation !== null && recipient !== null;
Astro.response.status = unavailable ? 503 : found ? 200 : 404;
const calendarUrl = canonicalUrl ? new URL('/calendar.ics', canonicalUrl).toString() : '/calendar.ics';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#122b23" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>{invitation && recipient ? `${invitation.brideName} & ${invitation.groomName} — Undangan Pernikahan` : 'Undangan — HariBahagia'}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  </head>
  <body>
    {invitation && recipient
      ? <InvitationPage invitation={invitation} recipient={recipient} calendarUrl={calendarUrl} guestSlug={slug} rsvpStatus={rsvpStatus} />
      : <main class="publication-state"><h1>{unavailable ? 'Undangan belum dapat dimuat' : 'Undangan tidak tersedia'}</h1><p>{unavailable ? 'Silakan coba kembali beberapa saat lagi.' : 'Tautan undangan tidak tersedia.'}</p></main>}
  </body>
</html>
