SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Existing Supabase Auth user UUID; owns the draft row and media folder. Nobody logs in with it.
ADMIN_USER_ID=your-supabase-auth-user-uuid
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
# The app's own admin login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=a-long-unique-password
ADMIN_SESSION_SECRET=at-least-32-random-characters-here
PUBLIC_SITE_URL=https://undangan.example.com
