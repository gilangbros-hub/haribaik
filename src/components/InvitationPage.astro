---
import type { WeddingContent } from '../lib/content';
import Icon from './Icon.astro';
import { formatWeddingDate, lineage } from '../lib/content';
import type { WeddingMediaUrls } from '../lib/content/media';
import type { GuestWish } from '../lib/guests/wishes';
import '../styles/invitation.css';

interface Props {
  invitation: WeddingContent;
  recipient?: string;
  preview?: boolean;
  calendarUrl?: string;
  media?: WeddingMediaUrls;
  guestSlug?: string;
  rsvpStatus?: 'attending' | 'declined' | null;
  wishes?: GuestWish[];
}

const { invitation, recipient = 'Sahabat dan keluarga', preview = false, calendarUrl = '/calendar.ics', media, guestSlug, rsvpStatus = null, wishes = [] } = Astro.props;
const wishDate = (value: string) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric', timeZone: invitation.timeZone }).format(new Date(value));
const coupleName = `${invitation.brideName} & ${invitation.groomName}`;
const firstDate = invitation.events[0] ? formatWeddingDate(invitation.events[0].startsAt, invitation.timeZone) : '';
const profiles = [
  { name: invitation.brideName, role: 'Mempelai wanita', lineage: lineage(invitation.brideChild, invitation.brideOrder, invitation.brideParents) },
  { name: invitation.groomName, role: 'Mempelai pria', lineage: lineage(invitation.groomChild, invitation.groomOrder, invitation.groomParents) },
];
// Only accounts with a number are shown; old content has no bank fields.
const accounts = [
  { role: 'Mempelai wanita', bank: invitation.brideBank, number: invitation.brideAccount, holder: invitation.brideName },
  { role: 'Mempelai pria', bank: invitation.groomBank, number: invitation.groomAccount, holder: invitation.groomName },
].filter((account) => account.number);
// Blank lines split paragraphs; a block starting with "#" is a subheading. Old content has no storyText.
const storyBlocks = (invitation.storyText ?? '').split(/\r?\n\s*\r?\n/).map((block) => block.trim()).filter(Boolean);
// Closing salam mirrors an Islamic opening greeting; other greetings get none.
const salam = /assalamu/i.test(invitation.greeting) ? 'Wassalamu’alaikum warahmatullahi wabarakatuh' : '';
const families = [invitation.brideParents, invitation.groomParents].filter(Boolean);
---

<aside class="desktop-story" aria-label="Pernikahan">
  <a class="wordmark" href="#invitation"><Icon name="flower" /> HARI BAHAGIA</a>
  <div class="story-copy">
    <p class="eyebrow">Undangan pernikahan</p>
    <p class="story-title">Mugia langgeng<br /><em>salawasna.</em></p>
    <p class="story-translation">Semoga bersama, selamanya.</p>
    <div class="story-rule"></div>
    <p class="story-couple">{coupleName}</p>
    <p class="story-date">{firstDate}</p>
  </div>
  <img class="story-landscape" src="/images/priangan-landscape.webp" alt="" width="1536" height="1024" />
  <p class="story-footnote">{invitation.coverBrideName || invitation.brideName} & {invitation.coverGroomName || invitation.groomName} <Icon name="flower" /></p>
</aside>

<main id="invitation" tabindex="-1">
  <section class="cover" aria-labelledby="cover-title">
    {media?.coverImage
      ? <img class="cover-visual cover-photo" src={media.coverImage} alt={invitation.coverImage?.alt ?? ''} width="853" height="1280" fetchpriority="high" />
      : <img class="cover-visual" src="/images/priangan-landscape.webp" alt="" width="1536" height="1024" fetchpriority="high" />}
    <div class="cover-art" aria-hidden="true">
      <img class="cover-botanical botanical-left" src="/images/jasmine-branch.svg" alt="" width="180" height="360" />
      <img class="cover-botanical botanical-right" src="/images/jasmine-branch.svg" alt="" width="180" height="360" />
      <span class="cover-frame"></span>
    </div>
    <div class="cover-topline"><Icon name="flower" /><span>WILUJENG SUMPING</span><Icon name="flower" /></div>
    <p class="eyebrow">{invitation.title}</p>
    <h1 id="cover-title"><span>{invitation.coverBrideName || invitation.brideName}</span><i>&</i><span>{invitation.coverGroomName || invitation.groomName}</span></h1>
    {firstDate && <p class="cover-date">{firstDate}</p>}
    <div class="recipient-card">
      <span>Kepada Bapak/Ibu/Saudara/i</span>
      <strong>{recipient}</strong>
    </div>
    <button class="open-button" type="button" data-open-invitation aria-controls="invitation-body" aria-expanded="false">
      Buka Undangan <Icon name="arrow" />
    </button>
    {media?.music && <><button class="music-button" type="button" data-music-toggle aria-pressed="false">Putar musik</button><audio data-invitation-audio src={media.music} preload="none" aria-label="Musik undangan"></audio><p data-audio-status role="status" aria-live="polite"></p></>}
    {preview && <p class="sample-note">Pratinjau — belum dipublikasikan</p>}
  </section>

  <noscript><style>#invitation-body[hidden] { display: block !important; } html:has(#invitation-body[hidden]) { overflow: auto; } [data-open-invitation] { display: none; }</style><p class="no-script-note">Silakan gulir untuk membaca undangan. Aktifkan JavaScript untuk mengirim ucapan.</p></noscript>
  <div id="invitation-body" class="invitation-body" tabindex="-1" hidden>
    <section class="welcome section" aria-labelledby="welcome-title">
      <span class="section-number" aria-hidden="true">01 / PAMBUKA</span>
      <img class="welcome-flower" src="/images/jasmine-branch.svg" alt="" width="100" height="200" loading="lazy" />
      <p class="eyebrow">{invitation.greeting}</p>
      <h2 id="welcome-title">Dengan syukur,<br /><em>kami mengundang Anda.</em></h2>
      <p>Kami akan menikah. Dengan restu keluarga, kami mengundang Bapak/Ibu/Saudara/i untuk hadir dan mendoakan pernikahan kami.</p>
      {invitation.description && <p>{invitation.description}</p>}
      <span class="ornament"><Icon name="flower" /></span>
    </section>

    <section id="mempelai" class="profiles section" aria-labelledby="profiles-title">
      <span class="section-number" aria-hidden="true">02 / DUA HATI</span>
      <p class="eyebrow">Silih asih, silih asah, silih asuh</p>
      <h2 id="profiles-title">Kedua <em>mempelai</em></h2>
      <div class="profile-grid">
          {profiles.map((profile, index) => {
            const image = index === 0 ? media?.brideImage : media?.groomImage;
            const imageData = index === 0 ? invitation.brideImage : invitation.groomImage;
            return (
          <article class="profile-card">
            <div class:list={['portrait', index === 0 ? 'portrait-one' : 'portrait-two']}>
              {image ? <img src={image} alt={imageData?.alt ?? ''} width="230" height="265" loading="lazy" /> : <span role="img" aria-label={`Foto ${profile.role} belum tersedia`}>{profile.name.charAt(0)}</span>}
            </div>
            <p class="eyebrow">{profile.role}</p>
            <h3>{profile.name}</h3>
            {profile.lineage && <p class="lineage">{profile.lineage}</p>}
          </article>
          );})}
      </div>
    </section>

    {(storyBlocks.length > 0 || media?.storyImage) && (
      <section id="cerita" class="story section" aria-labelledby="story-title" style={media?.storyImage ? `--story-bg: url("${media.storyImage}")` : undefined}>
        <p class="eyebrow">Sebelum hari ini</p>
        <h2 id="story-title">Cerita <em>Kami</em></h2>
        <div class="story-body">
          <div class="story-text">
            {storyBlocks.map((block) => block.startsWith('#')
              ? <h3>{block.replace(/^#+\s*/, '')}</h3>
              : <p>{block}</p>)}
          </div>
          {media?.storyImage && (
            <figure class="story-card">
              <img src={media.storyImage} alt={invitation.storyImage?.alt ?? ''} width="220" height="270" loading="lazy" />
            </figure>
          )}
        </div>
      </section>
    )}

    <div id="acara" class="events-wrap">
    {invitation.events.map((event, index) => (
      <section class="event section" aria-labelledby={`event-title-${index}`}>
        <span class="section-number" aria-hidden="true">{String(index + 3).padStart(2, '0')} / WAKTU & TEMPAT</span>
        <p class="eyebrow">Waktu & tempat</p>
        <h2 id={`event-title-${index}`}>{event.name || 'Acara'}</h2>
        <article class="event-card">
          <span class="event-symbol"><Icon name="calendar" /></span>
          <p class="event-date">{event.startsAt && formatWeddingDate(event.startsAt, invitation.timeZone)}</p>
          <p class="event-time">
            {event.startsAt && formatWeddingDate(event.startsAt, invitation.timeZone, { hour: '2-digit', minute: '2-digit' })}
            {event.endsAt && `–${formatWeddingDate(event.endsAt, invitation.timeZone, { hour: '2-digit', minute: '2-digit' })}`}
            {` ${{ 'Asia/Jakarta': 'WIB', 'Asia/Makassar': 'WITA', 'Asia/Jayapura': 'WIT' }[invitation.timeZone] ?? invitation.timeZone}`}
          </p>
          {event.startsAt && event.endsAt && event.startsAt.slice(0, 10) !== event.endsAt.slice(0, 10) && <p class="event-time">Sampai {formatWeddingDate(event.endsAt, invitation.timeZone)}</p>}
          <div class="rule"></div>
          <h3>{event.venue}</h3>
          <p>{event.address}</p>
          {(event.venue || event.address) && (
            <div class="event-map">
              {/* Keyless embed searches venue + address; the admin's map link may be a short link that cannot embed. */}
              <iframe src={`https://maps.google.com/maps?q=${encodeURIComponent([event.venue, event.address].filter(Boolean).join(', '))}&z=16&output=embed`} title={`Peta lokasi ${event.venue || event.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
              {event.mapUrl && <a class="map-open" href={event.mapUrl} target="_blank" rel="noreferrer"><Icon name="pin" /> Buka peta</a>}
            </div>
          )}
          <div class="event-actions">
            {event.mapUrl && <a class="text-link" href={event.mapUrl} target="_blank" rel="noreferrer"><Icon name="pin" /> Petunjuk arah</a>}
            <a class="text-link" href={calendarUrl} download="undangan.ics"><Icon name="calendar" /> Simpan tanggal</a>
          </div>
        </article>
      </section>
    ))}
    </div>

    {media?.gallery.some(Boolean) && (
      <section id="galeri" class="gallery section" aria-labelledby="gallery-title">
        <p class="eyebrow">Album foto</p>
        <h2 id="gallery-title">Beberapa momen <em>bersama.</em></h2>
        <div class="gallery-grid">
          {media.gallery.map((url, index) => url && invitation.gallery[index] && <img src={url} alt={invitation.gallery[index].alt} width="600" height="600" loading="lazy" decoding="async" />)}
        </div>
      </section>
    )}

    {guestSlug && (
    <section id="kehadiran" class="rsvp section" aria-labelledby="rsvp-title">
      <span class="ornament"><Icon name="heart" /></span>
      <p class="eyebrow">Konfirmasi kehadiran</p>
      <h2 id="rsvp-title">Sampai jumpa<br /><em>di hari pernikahan.</em></h2>
      <>
        <p>Undangan ini berlaku untuk satu orang.</p>
        <form data-rsvp-form data-endpoint={`/api/guests/${encodeURIComponent(guestSlug)}/rsvp`}>
          <fieldset>
            <legend>Apakah Anda akan hadir?</legend>
            <label><input type="radio" name="status" value="attending" checked={rsvpStatus === 'attending'} required /> Hadir</label>
            <label><input type="radio" name="status" value="declined" checked={rsvpStatus === 'declined'} required /> Tidak hadir</label>
          </fieldset>
          <button type="submit">Simpan jawaban</button>
          <p data-rsvp-status role="status" aria-live="polite">{rsvpStatus === 'attending' ? 'Jawaban tersimpan: hadir.' : rsvpStatus === 'declined' ? 'Jawaban tersimpan: tidak hadir.' : ''}</p>
        </form>
      </>
    </section>
    )}

    {accounts.length > 0 && (
      <section id="hadiah" class="gift section" aria-labelledby="gift-title">
        <span class="section-icon"><Icon name="gift" /></span>
        <p class="eyebrow">Amplop digital</p>
        <h2 id="gift-title">Tanda <em>kasih</em></h2>
        <p class="gift-hint">Doa dan kehadiran Anda sudah sangat berarti. Jika ingin memberikan hadiah, Anda dapat menggunakan rekening berikut.</p>
        <div class="gift-list">
          {accounts.map((account) => (
            <article class="gift-card">
              <p class="gift-role">{account.role}</p>
              <p class="gift-bank">{account.bank}</p>
              <p class="gift-number">{account.number}</p>
              <p class="gift-holder">a/n {account.holder}</p>
              <button type="button" data-copy={account.number.replace(/\D/g, '') || account.number}>Salin nomor</button>
            </article>
          ))}
        </div>
      </section>
    )}

    <section id="ucapan" class="wishes section" aria-labelledby="wishes-title">
      <span class="section-icon"><Icon name="message" /></span>
      <p class="eyebrow">Ucapan & doa</p>
      <h2 id="wishes-title">Sepatah kata,<br /><em>sebuah doa.</em></h2>
      <p class="section-intro">Ada pesan untuk kami? Tuliskan di sini, termasuk jika Anda belum bisa hadir. Ucapan akan tampil di undangan ini.</p>
      {preview ? <p class="wish-note">Formulir ucapan tampil di undangan asli.</p> : (
        <form class="wish-form" data-wish-form data-endpoint="/api/wishes">
          <label><span>Nama (opsional)</span><input name="name" maxlength="80" autocomplete="name" value={recipient === 'Sahabat dan keluarga' ? '' : recipient} placeholder="Nama Anda" /></label>
          <label><span>Ucapan</span><textarea name="message" maxlength="2000" required rows="4" placeholder="Tulis ucapan dan doa untuk kami…"></textarea></label>
          <button type="submit">Kirim ucapan <Icon name="arrow" /></button>
          <p data-wish-status role="status" aria-live="polite"></p>
        </form>
      )}
    </section>

    <section class="wish-wall section" aria-labelledby="wall-title">
      <p class="eyebrow"><span data-wish-count>{wishes.length}</span> ucapan</p>
      <h2 id="wall-title">Dari orang-orang <em>tersayang</em></h2>
      <ul class="wish-list" data-wish-list>
        {wishes.map((wish) => (
          <li class="wish-item">
            <span class="wish-avatar" aria-hidden="true">{wish.name.charAt(0).toUpperCase()}</span>
            <div>
              <p class="wish-name">{wish.name} <time datetime={wish.createdAt}>{wishDate(wish.createdAt)}</time></p>
              <p class="wish-message">{wish.message}</p>
            </div>
          </li>
        ))}
      </ul>
      {wishes.length === 0 && <p class="wish-note" data-wish-empty>Jadilah yang pertama mengirim doa.</p>}
    </section>

    <section id="panduan" class="guest-guide section" aria-labelledby="guide-title">
      <p class="eyebrow">Sebelum berangkat</p>
      <h2 id="guide-title">Agar lebih <em>mudah.</em></h2>
      <p class="section-intro">Beberapa hal untuk membantu Anda menyiapkan kunjungan.</p>
      <div class="guide-steps">
        <article><Icon name="calendar" /><div><h3>Simpan jadwalnya</h3><p>Gunakan “Simpan tanggal” pada bagian acara untuk menambahkan jadwal ke kalender Anda. Periksa kembali waktu yang tertera.</p></div></article>
        <article><Icon name="pin" /><div><h3>Rencanakan perjalanan</h3><p>Buka “Petunjuk arah” untuk melihat rute ke lokasi. Beri waktu tambahan untuk perjalanan dan mencari tempat parkir.</p></div></article>
        {guestSlug && <article><Icon name="heart" /><div><h3>Kabari kehadiran Anda</h3><p>Isi konfirmasi kehadiran melalui undangan ini agar kami dapat menyiapkan penyambutan.</p></div></article>}
      </div>
      <div class="guest-faq">
        <details><summary>Bagaimana cara menyimpan jadwal?</summary><p>Ketuk “Simpan tanggal”, lalu buka berkas undangan.ics dengan aplikasi kalender. Konfirmasikan penambahan acara di aplikasi tersebut.</p></details>
        <details><summary>Bagaimana jika peta tidak tampil?</summary><p>Ketuk “Petunjuk arah” untuk membuka peta di tab baru. Alamat lengkap juga tercantum pada bagian acara.</p></details>
        <details><summary>Apakah harus memberikan hadiah?</summary><p>Tidak. Kami berterima kasih atas doa dan perhatian Anda, dengan atau tanpa hadiah.</p></details>
      </div>
    </section>

    <footer class="closing section" aria-labelledby="closing-title">
      <div class="closing-card">
        <span class="monogram" aria-hidden="true">{invitation.brideName.charAt(0)} <i>&</i> {invitation.groomName.charAt(0)}</span>
        <p class="eyebrow">Terima kasih</p>
        <p class="closing-message">{invitation.closing || 'Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu.'}</p>
        {salam && <p class="closing-salam">{salam}</p>}
        <div class="rule" aria-hidden="true"></div>
        <p class="eyebrow">Kami yang berbahagia</p>
        <h2 id="closing-title">{invitation.coverBrideName || invitation.brideName} <i>&</i> {invitation.coverGroomName || invitation.groomName}</h2>
        {families.length > 0 && <p class="closing-family">Beserta keluarga besar<br />{families.join(' · ')}</p>}
        {firstDate && <p class="footer-date">{firstDate}</p>}
      </div>
      <p class="made-with">HARI BAHAGIA <Icon name="flower" /> MUGIA LANGGENG SALAWASNA</p>
    </footer>
  </div>
  <nav class="invitation-nav" aria-label="Bagian undangan">
    <a href="#invitation-body" aria-label="Pembuka"><Icon name="home" /></a>
    <a href="#mempelai">Mempelai</a>
    <a href="#acara">Acara</a>
    {media?.gallery.some(Boolean) && <a href="#galeri">Galeri</a>}
    {guestSlug && <a href="#kehadiran">RSVP</a>}
    <a href="#ucapan">Ucapan</a>
  </nav>
</main>

<script>
  const wishForm = document.querySelector<HTMLFormElement>('[data-wish-form]');
  wishForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = wishForm.querySelector<HTMLElement>('[data-wish-status]')!;
    const button = wishForm.querySelector<HTMLButtonElement>('button')!;
    const data = new FormData(wishForm);
    button.disabled = true;
    status.textContent = 'Mengirim…';
    try {
      const res = await fetch(wishForm.dataset.endpoint!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: data.get('name'), message: data.get('message') }) });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error ?? 'Ucapan belum terkirim.');
      const list = document.querySelector('[data-wish-list]');
      if (list) {
        // textContent only: guest text must never become HTML.
        const item = document.createElement('li');
        item.className = 'wish-item';
        const avatar = Object.assign(document.createElement('span'), { className: 'wish-avatar', textContent: body.wish.name.charAt(0).toUpperCase() });
        avatar.setAttribute('aria-hidden', 'true');
        const text = document.createElement('div');
        const name = Object.assign(document.createElement('p'), { className: 'wish-name', textContent: `${body.wish.name} ` });
        name.append(Object.assign(document.createElement('time'), { textContent: 'Baru saja' }));
        text.append(name, Object.assign(document.createElement('p'), { className: 'wish-message', textContent: body.wish.message }));
        item.append(avatar, text);
        list.prepend(item);
        document.querySelector('[data-wish-empty]')?.remove();
        const count = document.querySelector('[data-wish-count]');
        if (count) count.textContent = String(list.children.length);
      }
      (wishForm.elements.namedItem('message') as HTMLTextAreaElement).value = '';
      status.textContent = 'Terima kasih atas doanya!';
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Ucapan belum terkirim.';
    } finally {
      button.disabled = false;
    }
  });
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.textContent = 'Tersalin';
    } catch {
      button.textContent = 'Gagal menyalin';
    }
    setTimeout(() => { button.textContent = 'Salin nomor'; }, 2000);
  }));
  const audio = document.querySelector<HTMLAudioElement>('[data-invitation-audio]');
  const musicButton = document.querySelector<HTMLButtonElement>('[data-music-toggle]');
  const audioStatus = document.querySelector<HTMLElement>('[data-audio-status]');
  const updateMusic = () => {
    if (!audio || !musicButton) return;
    const playing = !audio.paused;
    musicButton.textContent = playing ? 'Jeda musik' : 'Putar musik';
    musicButton.setAttribute('aria-pressed', String(playing));
  };
  audio?.addEventListener('play', updateMusic);
  audio?.addEventListener('pause', updateMusic);
  audio?.addEventListener('error', () => { if (audioStatus) audioStatus.textContent = 'Musik tidak dapat diputar. Anda tetap dapat membaca undangan.'; });
  const startMusic = () => {
    if (!audio) return;
    audio.play().then(() => { if (audioStatus) audioStatus.textContent = ''; }).catch(() => {
      if (audioStatus) audioStatus.textContent = 'Musik tidak dapat diputar. Anda tetap dapat membaca undangan.';
    });
  };
  musicButton?.addEventListener('click', () => {
    if (!audio) return;
    if (audio.paused) startMusic();
    else audio.pause();
  });
  document.querySelector<HTMLButtonElement>('[data-open-invitation]')?.addEventListener('click', async (event) => {
    const body = document.querySelector<HTMLElement>('#invitation-body');
    const cover = document.querySelector<HTMLElement>('.cover');
    if (!body || !cover) return;
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    startMusic();
    if (!reducedMotion) {
      await cover.animate([{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-36px)' }], { duration: 550, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'forwards' }).finished.catch(() => {});
    }
    // Keep audio controls available after the cover leaves the document flow.
    if (musicButton) document.querySelector('#invitation')?.append(musicButton);
    if (audioStatus) document.querySelector('#invitation')?.append(audioStatus);
    cover.hidden = true;
    body.hidden = false;
    button.setAttribute('aria-expanded', 'true');
    document.querySelector('#invitation')?.classList.add('is-open');
    window.scrollTo({ top: 0, behavior: 'instant' });
    body.focus({ preventScroll: true });
    if (!reducedMotion) body.animate([{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 700, easing: 'cubic-bezier(.22,1,.36,1)' });
  });

  const sections = document.querySelectorAll<HTMLElement>('.section > .eyebrow, .section > h2, .section > p:not(.eyebrow), .profile-card, .story-body, .event-card, .gallery-grid img, .gift-card, .wish-form, .wish-list, .guide-steps article, .guest-faq, .closing-card');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0, rootMargin: '0px 0px -35px 0px' });
    sections.forEach((section) => { section.classList.add('will-reveal'); observer.observe(section); });
  }
</script>

<script>
  document.querySelector<HTMLFormElement>('[data-rsvp-form]')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[data-rsvp-status]')!;
    const answer = new FormData(form).get('status');
    if (answer !== 'attending' && answer !== 'declined') {
      status.textContent = 'Pilih hadir atau tidak hadir.';
      return;
    }
    button.disabled = true;
    status.textContent = 'Mengirim jawaban…';
    try {
      const response = await fetch(form.dataset.endpoint!, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ status: answer }),
      });
      const result = await response.json();
      if (!response.ok || result.saved !== true) throw new Error(result.error || 'Jawaban belum tersimpan.');
      status.textContent = answer === 'attending' ? 'Jawaban tersimpan: hadir.' : 'Jawaban tersimpan: tidak hadir.';
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Jawaban belum tersimpan. Periksa koneksi lalu coba lagi.';
    } finally {
      button.disabled = false;
    }
  });
</script>
