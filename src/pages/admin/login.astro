---
const setupRequired = Astro.url.searchParams.has('setup');
const loginFailed = Astro.url.searchParams.has('error');
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>Login Admin — HariBahagia</title>
  </head>
  <body>
    <main>
      <h1>Login Admin</h1>
      {setupRequired && <p role="status">Admin belum dikonfigurasi. Isi SUPABASE_URL, SUPABASE_ANON_KEY, dan ADMIN_USER_ID pada environment server.</p>}
      {loginFailed && <p role="alert">Login gagal. Periksa email, kata sandi, dan akses admin.</p>}
      <form method="post" action="/api/admin/login">
        <label>Email <input name="email" type="email" autocomplete="username" required /></label>
        <label>Kata sandi <input name="password" type="password" autocomplete="current-password" required /></label>
        <button type="submit">Masuk</button>
      </form>
    </main>
  </body>
</html>
